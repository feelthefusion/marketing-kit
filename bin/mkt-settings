#!/usr/bin/env bash
# =============================================================================
# Marketing Kit — feature switches.   Your settings, one file, both hosts.
#
#   mkt-settings                      show every switch and whether it is live
#   mkt-settings gsc   on|off         Google Search Console MCP (optional, default off)
#   mkt-settings apply [claude|hermes] re-sync MCP registrations to the switches (installers call this)
#
# File: ~/.config/marketing-kit/settings.env  (plain KEY=on|off — edit by hand if you like, then
# run `mkt-settings apply`). Secrets never go here; they live in secrets.env next to it.
# Core tracking is always first-party (your site → your Postgres). These switches only add or
# remove OPTIONAL read-only sources; turning one off unregisters its MCP server everywhere.
# Umami is not a switch: it is core (deploy with `mkt-umami deploy`).
# =============================================================================
set -uo pipefail
CONF="$HOME/.config/marketing-kit"
SETTINGS="${MKT_SETTINGS:-$CONF/settings.env}"
SECRETS="${MKT_SECRETS:-$CONF/secrets.env}"
MKT_MCP="$HOME/.local/bin/mkt-mcp"
[ -x "$MKT_MCP" ] || MKT_MCP="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)/mkt-mcp"

# name → settings key, description, secrets it needs (any one satisfies), hermes timeout
FEATURES="gsc"   # Umami is core (always on) — see mkt-umami
key_of()   { case "$1" in gsc) echo MKT_GSC ;; esac; }
desc_of()  { case "$1" in
    gsc)   echo "Google Search Console — search queries, impressions, CTR, position (read-only)" ;;
    esac; }
needs_of() { case "$1" in gsc) echo "GOOGLE_APPLICATION_CREDENTIALS GSC_OAUTH_CLIENT_SECRETS_FILE" ;; esac; }

say()  { printf '%s\n' "$*"; }
ok()   { printf '  ✓ %s\n' "$*"; }
warn() { printf '  ⚠ %s\n' "$*"; }
die()  { printf 'mkt-settings: %s\n' "$*" >&2; exit 1; }

ensure_file() {
    mkdir -p "$CONF"
    [ -f "$SETTINGS" ] || cat > "$SETTINGS" <<'EOF'
# Marketing Kit feature switches — on|off. Change with `mkt-settings <feature> on|off`
# (or edit, then `mkt-settings apply`). Core tracking is always first-party.
MKT_GSC=off
EOF
}
get() { local v=""; [ -f "$SETTINGS" ] && v="$(grep -E "^$1=" "$SETTINGS" | tail -1 | cut -d= -f2- | tr -d "\"' ")"; echo "${v:-off}"; }
set_key() {  # set_key KEY VALUE — replace or append, keep comments
    ensure_file
    if grep -qE "^$1=" "$SETTINGS"; then
        local tmp; tmp="$(mktemp)"; sed -E "s/^$1=.*/$1=$2/" "$SETTINGS" > "$tmp" && cat "$tmp" > "$SETTINGS"; rm -f "$tmp"
    else printf '%s=%s\n' "$1" "$2" >> "$SETTINGS"; fi
}
has_secret() { [ -n "${!1:-}" ] && return 0; [ -f "$SECRETS" ] && grep -qE "^$1=.+" "$SECRETS"; }
creds_ok() { local k; for k in $(needs_of "$1"); do has_secret "$k" && return 0; done; return 1; }

find_claude() { command -v claude 2>/dev/null || { [ -x "$HOME/.claude/local/claude" ] && echo "$HOME/.claude/local/claude"; }; }

apply_one() {  # apply_one <feature> <host|all>
    local f="$1" host="$2" state; state="$(get "$(key_of "$f")")"
    local CL; CL="$(find_claude || true)"
    if [ "$host" != hermes ] && [ -n "$CL" ]; then
        "$CL" mcp remove -s user "$f" >/dev/null 2>&1 || true
        if [ "$state" = on ]; then
            if creds_ok "$f"; then
                "$CL" mcp add -s user "$f" -- "$MKT_MCP" "$f" >/dev/null 2>&1 && ok "claude: $f registered" || warn "claude: $f add failed"
            else warn "claude: $f is ON but not registered — add one of [$(needs_of "$f")] to $SECRETS, then: mkt-settings apply"; fi
        else ok "claude: $f off (unregistered)"; fi
    fi
    if [ "$host" != claude ] && command -v hermes >/dev/null 2>&1; then
        if [ "$state" = on ] && creds_ok "$f"; then
            hermes config set "mcp_servers.$f" "{\"command\": \"$MKT_MCP\", \"args\": [\"$f\"], \"timeout\": 180}" >/dev/null 2>&1 \
                && ok "hermes: $f registered" || warn "hermes: $f config set failed"
        else
            hermes mcp remove "$f" </dev/null >/dev/null 2>&1 || true
            [ "$state" = on ] && warn "hermes: $f is ON but not registered — add one of [$(needs_of "$f")] to $SECRETS, then: mkt-settings apply" \
                              || ok "hermes: $f off (unregistered)"
        fi
    fi
}

show() {
    ensure_file
    say "Marketing Kit settings  ($SETTINGS)"
    say "  core   first-party tracking → your Postgres + Umami dashboard   always on"
    local f
    for f in $FEATURES; do
        local st; st="$(get "$(key_of "$f")")"
        local cr="credentials ✓"; creds_ok "$f" || cr="needs $(needs_of "$f" | sed 's/ / or /')"
        printf '  %-6s %-3s  %s\n         %s\n' "$f" "$st" "$(desc_of "$f")" "$cr"
    done
    say "Change: mkt-settings gsc on|off   (restart Claude Code / start a new Hermes session after)"
}

case "${1:-show}" in
    show|'') show ;;
    apply)
        ensure_file; host="${2:-all}"
        case "$host" in all|claude|hermes) ;; *) die "apply [claude|hermes]" ;; esac
        for f in $FEATURES; do apply_one "$f" "$host"; done ;;
    gsc)
        f="$1"; v="${2:-}"
        case "$v" in on|off) ;; *) die "usage: mkt-settings $f on|off   (now: $(get "$(key_of "$f")"))" ;; esac
        set_key "$(key_of "$f")" "$v"
        say "$f → $v"
        apply_one "$f" all
        [ "$v" = on ] && [ "$f" = gsc ]   && say "  setup: skill journey-analytics → references/search-console.md"
        say "  restart Claude Code / start a new Hermes session to pick it up" ;;
    -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown '$1' — try: mkt-settings --help" ;;
esac
