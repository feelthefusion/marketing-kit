#!/usr/bin/env bash
# =============================================================================
# Marketing Kit — doctor.   mkt-doctor [--live]
# What is wired on this machine and in the current repo, with the exact fix for each gap.
# --live additionally starts each MCP server briefly to prove it launches (needs network).
# =============================================================================
set -uo pipefail
SELF="${BASH_SOURCE[0]}"; while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
KIT_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
SECRETS="$HOME/.config/marketing-kit/secrets.env"
G=0; Y=0
pass() { printf '  ✓ %s\n' "$*"; G=$((G+1)); }
gap()  { printf '  ✗ %s\n      fix: %s\n' "$1" "$2"; Y=$((Y+1)); }
has()  { [ -f "$SECRETS" ] && grep -qE "^$1=.+" "$SECRETS"; }

echo "── Marketing Kit doctor ($(git -C "$KIT_ROOT" rev-parse --short HEAD 2>/dev/null || echo '?'))"
echo "▶ machine"
for t in node uvx railway psql; do command -v $t >/dev/null 2>&1 && pass "$t" || gap "$t missing" "re-run the kit installer (psql: brew install libpq)"; done
for b in mkt-mcp mkt-ledger mkt-preflight mkt-init mkt-settings mkt-umami mkt-update mkt-webhooks; do command -v $b >/dev/null 2>&1 && pass "$b on PATH" || gap "$b not on PATH" "export PATH=\"\$HOME/.local/bin:\$PATH\""; done
# living updates: the session-start hook is what keeps every component current
grep -q "mkt-update --hook" "$HOME/.claude/settings.json" 2>/dev/null && pass "Claude Code SessionStart → mkt-update (living updates)" \
    || gap "Claude Code SessionStart hook missing" "re-run the installer (install/install.sh)"
if command -v hermes >/dev/null 2>&1; then
    hermes config get hooks 2>/dev/null | grep -q "mkt-update" && pass "Hermes on_session_start → mkt-update (living updates)" \
        || gap "Hermes on_session_start hook missing" "re-run install/hermes.sh"
fi
[ -f "$HOME/.config/marketing-kit/update-state.json" ] && pass "last upstream check: $(python3 -c 'import json,time,os; t=json.load(open(os.path.expanduser("~/.config/marketing-kit/update-state.json"))).get("checked_at"); print(time.strftime("%F %T", time.localtime(t)) if t else "never")')" \
    || gap "no upstream check yet" "mkt-update"
[ -f "$SECRETS" ] && [ "$(stat -f %Lp "$SECRETS" 2>/dev/null || stat -c %a "$SECRETS")" = 600 ] && pass "secrets.env (600)" || gap "secrets.env missing or not 600" "re-run installer; chmod 600 $SECRETS"
has TELNYX_API_KEY && pass "TELNYX_API_KEY" || gap "TELNYX_API_KEY empty" "add it to $SECRETS, re-run installer"
has RESEND_API_KEY && pass "RESEND_API_KEY" || echo "  · RESEND_API_KEY empty (fine on Claude Code — plugin uses OAuth; needed for Hermes)"
# Umami = core web analytics (self-hosted on your Railway)
has UMAMI_DATABASE_URL && pass "Umami DB url set (umami MCP)" || gap "Umami not deployed" "in an app repo: mkt-umami deploy"
has UMAMI_URL && { curl -fsS --max-time 6 "$(grep -E '^UMAMI_URL=' "$SECRETS" | cut -d= -f2-)/api/heartbeat" >/dev/null 2>&1 \
    && pass "Umami dashboard up" || gap "Umami dashboard not answering" "mkt-umami status · railway logs -s umami"; }
# Optional switches
GSC="$(grep -E '^MKT_GSC=' "$HOME/.config/marketing-kit/settings.env" 2>/dev/null | cut -d= -f2)"
if [ "${GSC:-off}" = on ]; then
    { has GOOGLE_APPLICATION_CREDENTIALS || has GSC_OAUTH_CLIENT_SECRETS_FILE; } && pass "Search Console ON + credentials" \
        || gap "Search Console ON but no credentials" "GOOGLE_APPLICATION_CREDENTIALS in $SECRETS, then mkt-settings apply"
else echo "  · Search Console off (optional — mkt-settings gsc on)"; fi
"$KIT_ROOT/bin/mkt-ledger" doctor >/dev/null 2>&1 && pass "Supermemory ledger reachable" || gap "Supermemory ledger unreachable" "launchctl kickstart -k gui/\$(id -u)/com.supermemory.local  (or run supermemory-server)"

echo "▶ hosts"
if [ -d "$HOME/.claude" ]; then
    for s in marketing-kit growth-data journey-analytics campaign-harden lifecycle-engine playbook-ledger; do
        [ -L "$HOME/.claude/skills/$s" ] && [ -f "$HOME/.claude/skills/$s/SKILL.md" ] || { gap "Claude Code skill $s not linked" "bash $KIT_ROOT/install/install.sh"; continue; }
    done; [ -L "$HOME/.claude/skills/marketing-kit" ] && pass "Claude Code kit skills linked (live)"
    if command -v claude >/dev/null 2>&1; then
        PL="$(claude plugin list 2>/dev/null)"
        while IFS=$'\t' read -r p _ sc _; do case "$p" in ''|\#*) continue;; esac; [ "$sc" = user ] || continue
            grep -q "❯ $p\$" <<<"$PL" && pass "plugin $p (user)" || gap "plugin $p missing" "claude plugin install $p --scope user"; done < "$KIT_ROOT/install/claude-plugins.tsv"
    fi
fi
if command -v hermes >/dev/null 2>&1; then
    [ -L "${HERMES_HOME:-$HOME/.hermes}/skills/marketing/marketing-kit" ] && pass "Hermes kit skills linked (live)" || gap "Hermes kit skills not linked" "bash $KIT_ROOT/install/hermes.sh"
    [ "$(hermes config get memory.provider 2>/dev/null)" = supermemory ] && pass "Hermes memory.provider = supermemory" || gap "Hermes memory provider not supermemory" "hermes config set memory.provider supermemory"
fi

echo "▶ repo ($(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"))"
if git rev-parse --show-toplevel >/dev/null 2>&1; then
    R="$(git rev-parse --show-toplevel)"
    [ -f "$R/.agents/growth-stack.md" ] && pass "growth-stack.md" || gap "no .agents/growth-stack.md" "mkt-init"
    if [ -d "$HOME/.claude" ]; then while IFS=$'\t' read -r p _ sc _; do [ "$sc" = project ] || continue
        grep -q "\"$p\": *true" "$R/.claude/settings.json" 2>/dev/null && pass "plugin $p (this repo)" || gap "plugin $p not enabled here" "mkt-init"
    done < "$KIT_ROOT/install/claude-plugins.tsv"; fi
    [ -f "$R/.agents/product-marketing.md" ] && pass "product-marketing.md" || gap "no .agents/product-marketing.md" "ask the agent: \"set up product marketing context\""
    if grep -q '?' "$R/.agents/growth-stack.md" 2>/dev/null; then echo "  · growth-stack.md still has $(grep -c '?' "$R/.agents/growth-stack.md") '?' line(s) to fill"; fi
    SRC_DIRS="$(for d in app src pages lib components; do [ -d "$R/$d" ] && printf '%s ' "$R/$d"; done)"
    if [ -n "$SRC_DIRS" ]; then
        grep -rlq "marketing-kit:collector" $SRC_DIRS 2>/dev/null && pass "first-party collector in app (crm_events)" \
            || gap "no first-party event collector yet" "ask the agent: \"add the journey-analytics first-party collector\" (references/first-party-tracking.ts)"
        grep -rlqE "data-website-id" $SRC_DIRS 2>/dev/null && pass "Umami tracker in app" || gap "Umami tracker not in app" "mkt-umami snippet <website-id>"
    fi
    if DBSRC="$("$KIT_ROOT/bin/mkt-mcp" db-resolve "$R" 2>/dev/null)"; then pass "CRM DB resolvable ($DBSRC)"
    else gap "no CRM database for this repo" "CRM_DATABASE_URL in .agents/marketing-kit.env, or: railway link"; fi
    ls "$R"/campaigns/*.campaign.json >/dev/null 2>&1 && { "$KIT_ROOT/bin/mkt-preflight" "$R"/campaigns/*.campaign.json >/dev/null && pass "campaigns preflight GREEN" || gap "campaigns preflight RED" "mkt-preflight campaigns/*.campaign.json"; }
else echo "  · not in a git repo — repo checks skipped"; fi

if [ "${1:-}" = --live ]; then
    echo "▶ live MCP launch (5s each; initialize handshake)"
    INIT='{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"mkt-doctor","version":"1"}}}'
    LIVE="db telnyx resend railway umami"; [ "${GSC:-off}" = on ] && LIVE="$LIVE gsc"
    for s in $LIVE; do
        out="$( (printf '%s\n' "$INIT"; sleep 12) | "$KIT_ROOT/bin/mkt-mcp" $s 2>/tmp/mkt-live.$$ | head -c 400 & p=$!; ( sleep 25; kill $p 2>/dev/null ) & wait $p 2>/dev/null)"
        if grep -q '"result"' <<<"$out"; then pass "mkt-mcp $s initialize OK"
        else printf '  ✗ mkt-mcp %s: %s\n' "$s" "$(grep -v '^ *$' /tmp/mkt-live.$$ | tail -1 | cut -c1-140)"; Y=$((Y+1)); fi
    done; rm -f /tmp/mkt-live.$$
fi
echo "── $G ok · $Y to fix"
[ "$Y" = 0 ]
