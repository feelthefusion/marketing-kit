#!/usr/bin/env bash
# =============================================================================
# Marketing Kit — Umami (core web analytics, self-hosted on YOUR Railway project).
#
#   mkt-umami deploy [--dry-run|--yes] add Postgres + the official Umami image to the linked Railway
#                                  project, generate secrets, create a domain, store
#                                  UMAMI_DATABASE_URL (read-only MCP) + UMAMI_URL in secrets.env
#   mkt-umami status               heartbeat + whether the MCP can reach its DB
#   mkt-umami snippet [website-id] Next.js tracker + identify() code for the app
#
# Image: ghcr.io/umami-software/umami:latest (Umami's own; redeploy = newest release).
# Why Umami AND crm_events: Umami is the dashboard (visitors, referrers, UTMs, pages); crm_events
# in the app DB drives triggers and joins to orders/messages. umami.identify(contactId) links the
# two per person (Umami session.distinct_id = crm_contacts.id).
# =============================================================================
set -euo pipefail
CONF="$HOME/.config/marketing-kit"; SECRETS="${MKT_SECRETS:-$CONF/secrets.env}"
IMAGE="ghcr.io/umami-software/umami:latest"
APP_SVC="${UMAMI_SERVICE:-umami}"; DB_SVC="${UMAMI_DB_SERVICE:-umami-db}"
say() { printf '%s\n' "$*"; }; ok() { printf '  ✓ %s\n' "$*"; }; warn() { printf '  ⚠ %s\n' "$*"; }
die() { printf 'mkt-umami: %s\n' "$*" >&2; exit 1; }
[ -f "$SECRETS" ] && { set -a; . "$SECRETS"; set +a; }

put_secret() {  # put_secret KEY VALUE (replace or append; file stays 600)
    mkdir -p "$CONF"; touch "$SECRETS"; chmod 600 "$SECRETS"
    local tmp; tmp="$(mktemp)"; grep -vE "^$1=" "$SECRETS" > "$tmp" || true
    printf '%s=%s\n' "$1" "$2" >> "$tmp"; cat "$tmp" > "$SECRETS"; rm -f "$tmp"
}
rand_hex() { openssl rand -hex "$1" 2>/dev/null || head -c "$1" /dev/urandom | od -An -tx1 | tr -d ' \n'; }
kv() { railway variables -s "$1" --kv 2>/dev/null | grep -E "^$2=" | head -1 | cut -d= -f2-; }
svc_names() { railway service list --json 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); d=d if isinstance(d,list) else d.get("services",[]); print("\n".join(s["name"] for s in d))'; }

deploy() {
    local dry=0 yes=0; case "${1:-}" in --dry-run) dry=1 ;; --yes|-y) yes=1 ;; esac
    command -v railway >/dev/null 2>&1 || die "railway CLI missing — bash <(curl -fsSL https://railway.com/install.sh)"
    railway status >/dev/null 2>&1 || die "not linked — run \`railway link\` in the app repo first (Umami joins that project)"
    local proj; proj="$(railway status 2>/dev/null | sed -n 's/^Project: *//p' | head -1)"
    run() { if [ "$dry" = 1 ]; then printf '    $ %s\n' "$*"; else "$@"; fi; }
    say "Umami → Railway project '${proj:-linked}'"
    say "  adds: $DB_SVC (Postgres)  +  $APP_SVC ($IMAGE)  +  a public domain for $APP_SVC"
    say "  both are billable Railway services (small: Umami idles at ~150–250 MB RAM)."
    if [ "$dry" = 0 ]; then
        [ -n "$(kv "$APP_SVC" DATABASE_URL 2>/dev/null)" ] && die "service '$APP_SVC' already exists — use: mkt-umami status"
        if [ "$yes" = 1 ]; then a=y; else printf '  continue? [y/N] '; read -r a </dev/tty || a=n; fi
        case "$a" in y|Y|yes) ;; *) say "  aborted"; exit 1 ;; esac
    fi
    local before=""; [ "$dry" = 0 ] && before="$(svc_names)"
    run railway add -d postgres -s "$DB_SVC"
    # Railway CLI 5.x ignores -s for databases (names it Postgres-xxxx): use the name it chose
    if [ "$dry" = 0 ]; then
        local made; made="$(svc_names | grep -vxF "$before" | head -1)"
        [ -n "$made" ] && [ "$made" != "$DB_SVC" ] && { say "  Railway named the database '$made'"; DB_SVC="$made"; }
    fi
    run railway add -s "$APP_SVC" -i "$IMAGE" \
        -v "DATABASE_URL=\${{$DB_SVC.DATABASE_URL}}" \
        -v "APP_SECRET=$( [ "$dry" = 1 ] && echo '<random 32B hex>' || rand_hex 32)" \
        -v "TWO_FACTOR_ENCRYPTION_KEY=$( [ "$dry" = 1 ] && echo '<random 32B hex>' || rand_hex 32)" \
        -v "PORT=3000"
    run railway domain -s "$APP_SVC" --port 3000
    [ "$dry" = 1 ] && { say "  (dry run — nothing created)"; return 0; }

    say "  waiting for Postgres credentials…"
    local pub="" pw=""; for _ in $(seq 1 60); do pw="$(kv "$DB_SVC" PGPASSWORD)"; [ -n "$pw" ] && break; sleep 3; done
    pub="$(kv "$DB_SVC" DATABASE_PUBLIC_URL)"
    if [ -z "$pub" ] && [ -n "$pw" ]; then   # newer Postgres template: no public proxy by default
        railway tcp-proxy create --port 5432 --service "$DB_SVC" >/dev/null 2>&1 || warn "could not create a TCP proxy on $DB_SVC"
        local hp; hp="$(railway tcp-proxy list --service "$DB_SVC" --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["proxies"][0]["endpoint"])' 2>/dev/null)"
        [ -n "$hp" ] && pub="$(python3 -c 'import sys,urllib.parse as u; print("postgresql://%s:%s@%s/%s" % (sys.argv[1], u.quote(sys.argv[2], safe=""), sys.argv[3], sys.argv[4]))' "$(kv "$DB_SVC" PGUSER)" "$pw" "$hp" "$(kv "$DB_SVC" PGDATABASE)")"
    fi
    [ -n "$pub" ] || die "no DATABASE_PUBLIC_URL on $DB_SVC yet — re-run: mkt-umami status"
    put_secret UMAMI_DATABASE_URL "$pub"; ok "UMAMI_DATABASE_URL → $SECRETS (MCP 'umami' reads it read-only)"
    # living: mkt-update redeploys this service from the latest image when Umami cuts a release
    python3 - "${XDG_CONFIG_HOME:-$HOME/.config}/marketing-kit/update-state.json" "$(pwd)" <<'PY'
import json, os, sys
p, d = sys.argv[1:3]
s = json.load(open(p)) if os.path.exists(p) else {}
l = s.setdefault("umami_projects", [])
if d not in l: l.append(d)
os.makedirs(os.path.dirname(p), exist_ok=True); json.dump(s, open(p, "w"), indent=2)
PY
    ok "registered for auto-redeploy on new Umami releases (mkt-update)"
    local dom; dom="$(kv "$APP_SVC" RAILWAY_PUBLIC_DOMAIN)"
    [ -n "$dom" ] && { put_secret UMAMI_URL "https://$dom"; ok "UMAMI_URL=https://$dom"; }
    say ""
    say "Next (2 min):"
    say "  1. open ${dom:+https://$dom} → log in admin / umami → CHANGE THE PASSWORD"
    say "  2. Settings → Websites → Add your site → copy its Website ID"
    say "  3. mkt-umami snippet <website-id>   → paste into the app"
    say "  4. re-run the kit installer (registers the umami MCP in Claude Code + Hermes)"
}

status() {
    local u="${UMAMI_URL:-}"
    if [ -n "$u" ]; then
        curl -fsS --max-time 8 "$u/api/heartbeat" >/dev/null 2>&1 && ok "Umami up at $u" || warn "Umami not answering at $u/api/heartbeat"
    else warn "UMAMI_URL not set — run: mkt-umami deploy"; fi
    if [ -n "${UMAMI_DATABASE_URL:-}" ]; then
        if command -v psql >/dev/null 2>&1; then
            local n; n="$(psql "$UMAMI_DATABASE_URL" -Atc "select count(*) from website_event where created_at > now() - interval '24 hours'" 2>/dev/null)" \
                && ok "Umami DB reachable — $n events in the last 24h" || warn "Umami DB not reachable with UMAMI_DATABASE_URL"
        else ok "UMAMI_DATABASE_URL set (install psql to test the connection)"; fi
    else warn "UMAMI_DATABASE_URL not set — run: mkt-umami deploy"; fi
}

snippet() {
    local id="${1:-<WEBSITE_ID>}" u="${UMAMI_URL:-https://<your-umami-domain>}"
    cat <<EOF
// 1) app/layout.tsx — load the tracker (first-party analytics on your own Railway)
import Script from "next/script";
// inside <body>:
<Script src="$u/script.js" data-website-id="$id" strategy="afterInteractive" />

// 2) after login/signup (client) — link Umami's session to the CRM contact
//    (Umami session.distinct_id = crm_contacts.id, so SQL can join the two)
(window as any).umami?.identify(contact.id, { plan: contact.plan });

// 3) key product moments (Umami dashboard). Triggers still use crm_events via /api/t.
(window as any).umami?.track("signup_completed");

// Campaign links carry utm_campaign=<campaign id>; Umami stores utm_* per event automatically.
EOF
}

case "${1:-}" in
    deploy) shift; deploy "${1:-}" ;;
    status) status ;;
    snippet) shift; snippet "${1:-}" ;;
    *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
