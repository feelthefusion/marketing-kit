# Per-project Marketing Kit settings (gitignored by mkt-init). Read by mkt-mcp and mkt-preflight.
#
# CRM database the agent queries. Resolution order when unset here:
#   $CRM_DATABASE_URL → .env.local / .env (CRM_DATABASE_URL, DATABASE_PUBLIC_URL, DATABASE_URL)
#   → `railway variables` DATABASE_PUBLIC_URL of the linked project (*.railway.internal is skipped:
#     it is unreachable from a laptop).
# Best practice: point this at a read-only role or a read replica (growth-data skill has the SQL).
# CRM_DATABASE_URL=postgresql://growth_ro:...@xxx.proxy.rlwy.net:12345/railway

# restricted  = read-only transactions + query timeouts (default)
# unrestricted = full read/write + DDL through the crm-db MCP. Flip when you want the agent to
#                manipulate CRM rows directly; restart the session after changing it.
MKT_DB_ACCESS=restricted

# Railway service holding Postgres, if not named "Postgres"
# MKT_RAILWAY_DB_SERVICE=
