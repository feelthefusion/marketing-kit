# Marketing Kit — secrets for MCP servers (both Claude Code and Hermes read this via mkt-mcp).
# Location: ~/.config/marketing-kit/secrets.env   (installer creates it chmod 600; never commit)
# Leave a line blank to skip that server — the installer only registers servers whose keys exist.

# Telnyx (SMS) — https://portal.telnyx.com/#/api-keys
TELNYX_API_KEY=

# Resend (email) — https://resend.com/api-keys
# Claude Code uses Resend's hosted MCP via the official plugin (browser OAuth) and ignores this;
# Hermes uses it for the local resend-mcp server.
RESEND_API_KEY=
SENDER_EMAIL_ADDRESS=

# Google Analytics 4 + Search Console — ONE service-account JSON serves both.
# GA4: add the SA email as Viewer on the property. GSC: add it as a user on the property.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_PROJECT_ID=
# Optional: GSC via OAuth instead of the service account
# GSC_OAUTH_CLIENT_SECRETS_FILE=

# CRM database: normally resolved PER PROJECT (see .agents/marketing-kit.env). Setting it here
# forces one database for every project.
# CRM_DATABASE_URL=
